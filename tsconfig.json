{
  "compilerOptions": {
    // Build target
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Output — disabled during hardening, re-enable for builds
    "noEmit": true,
    // "outDir": "./dist",
    // "rootDir": "./src",
    "sourceMap": true,

    // Strict foundation — noImplicitAny and strictNullChecks
    // are already included here, do not list them separately
    "strict": true,

    // Hardening flags — add these one at a time per the roadmap
    // Start with Phase 4.1, fix all errors, then uncomment the next
    "noUncheckedIndexedAccess": true,   // Phase 4.1
    // "exactOptionalPropertyTypes": true, // Phase 4.2 — uncomment after 4.1 is clean
    // "noImplicitReturns": true,          // Phase 4.3 — uncomment after 4.2 is clean

    // Catch real mistakes
    "skipLibCheck": false,

    // Vite client types — enables import.meta.glob and asset imports
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}